#!/usr/bin/env bash
# Try to connect to all trusted Bluetooth devices that aren't already connected.
# Retries for a while so it works at login before the adapter is fully up.
# Run by systemd/user/bluetooth-autoconnect.service (Type=simple, so login
# never waits on it). Every bluetoothctl call is bounded with `timeout`:
# `bluetoothctl connect` can block for a long time on a device that is out of
# range, which used to hold the unit until systemd killed it.

ATTEMPTS=12
SLEEP=5

command -v bluetoothctl >/dev/null 2>&1 || exit 0

for ((i = 1; i <= ATTEMPTS; i++)); do
    # Wait for the adapter to be powered
    if ! timeout 5 bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
        sleep "$SLEEP"
        continue
    fi

    all_connected=true
    while read -r _ mac _; do
        [[ -z "$mac" ]] && continue
        if timeout 5 bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
            continue
        fi
        all_connected=false
        timeout 15 bluetoothctl connect "$mac" >/dev/null 2>&1
    done < <(timeout 5 bluetoothctl devices Trusted 2>/dev/null)

    $all_connected && exit 0
    sleep "$SLEEP"
done
exit 0
