#!/usr/bin/env bash

# Monolith - Ollama Manager
# Manage ollama service and models

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/monolith"
STATE_FILE="$STATE_DIR/selected_model"

ensure_state_dir() {
    mkdir -p "$STATE_DIR"
}

save_selected_model() {
    ensure_state_dir
    printf '%s\n' "$1" > "$STATE_FILE"
}

load_selected_model() {
    if [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE"
    fi
}

model_details() {
    case "$1" in
        qwen3-coder:30b)
            echo "default coding model"
            ;;
        qwen3-coder-gamedev:latest)
            echo "qwen3-coder:30b + gamedev/engine mentor system prompt"
            ;;
        qwen3-narrative-gamedesign:latest)
            echo "narrative and game design model for lore, quests, GDDs"
            ;;
        qwen3:30b-a3b)
            echo "general-purpose qwen model, lighter than coder-focused variants"
            ;;
        qwen2.5-coder:32b)
            echo "older coder model, still strong but less current than qwen3-coder"
            ;;
        *)
            echo "custom or unclassified model"
            ;;
    esac
}

list_models_plain() {
    while read -r name id size modified; do
        [ -z "$name" ] && continue
        printf '%s\t%s\n' "$name" "$(model_details "$name")"
    done < <(ollama list 2>/dev/null | tail -n +2)
}

current_model() {
    ollama ps 2>/dev/null | tail -n +2 | head -n 1 | awk '{print $1}'
}

print_header() {
    echo -e "${BLUE}╔════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}     ${GREEN}MONOLITH AI MANAGER${NC}       ${BLUE}║${NC}"
    echo -e "${BLUE}╚════════════════════════════════════╝${NC}\n"
}

check_ollama_status() {
    if systemctl is-active --quiet ollama; then
        echo -e "${GREEN}●${NC} Ollama Service: ${GREEN}RUNNING${NC}"
        return 0
    else
        echo -e "${RED}●${NC} Ollama Service: ${RED}STOPPED${NC}"
        return 1
    fi
}

show_loaded_models() {
    echo -e "\n${YELLOW}Currently Loaded:${NC}"
    local loaded=$(ollama ps 2>/dev/null)
    if [ -z "$loaded" ] || [ "$loaded" = "NAME    ID    SIZE    MODIFIED" ]; then
        echo "  No models loaded in VRAM"
    else
        echo "$loaded" | tail -n +2
    fi
}

list_models() {
    echo -e "\n${YELLOW}Available Models:${NC}"
    local index=1
    while read -r name id size modified; do
        [ -z "$name" ] && continue
        printf "%2d. %-32s (%s)\n" "$index" "$name" "$(model_details "$name")"
        index=$((index + 1))
    done < <(ollama list 2>/dev/null | tail -n +2)
}

select_model() {
    list_models
    echo -e "\n${BLUE}Select model number (or 'q' to quit):${NC} "
    read -r choice

    if [ "$choice" = "q" ]; then
        exit 0
    fi

    local model=$(ollama list 2>/dev/null | tail -n +2 | sed -n "${choice}p" | awk '{print $1}')

    if [ -z "$model" ]; then
        echo -e "${RED}Invalid selection${NC}"
        exit 1
    fi

    echo -e "\n${GREEN}Loading model: ${model}${NC}"
    echo -e "${YELLOW}Running chat... (Ctrl+D to exit)${NC}\n"
    save_selected_model "$model"
    ollama run "$model"
}

toggle_service() {
    if check_ollama_status >/dev/null 2>&1; then
        echo -e "\n${YELLOW}Stopping ollama service...${NC}"
        sudo systemctl stop ollama
        echo -e "${GREEN}✓${NC} Service stopped"
    else
        echo -e "\n${YELLOW}Starting ollama service...${NC}"
        sudo systemctl start ollama
        echo -e "${GREEN}✓${NC} Service started"
    fi
}

show_menu() {
    print_header
    check_ollama_status
    show_loaded_models

    echo -e "\n${BLUE}Options:${NC}"
    echo "  1) Select & run model"
    echo "  2) Toggle service (start/stop)"
    echo "  3) Show status"
    echo "  4) Unload all models"
    echo "  q) Quit"
    echo -e "\n${BLUE}Choice:${NC} "
    read -r choice

    case $choice in
        1)
            select_model
            ;;
        2)
            toggle_service
            echo ""
            read -p "Press enter to continue..."
            show_menu
            ;;
        3)
            show_menu
            ;;
        4)
            echo -e "\n${YELLOW}Unloading all models...${NC}"
            sudo systemctl restart ollama
            echo -e "${GREEN}✓${NC} All models unloaded"
            sleep 1
            show_menu
            ;;
        q|Q)
            echo -e "\n${GREEN}Goodbye!${NC}"
            exit 0
            ;;
        *)
            echo -e "${RED}Invalid choice${NC}"
            sleep 1
            show_menu
            ;;
    esac
}

# Main
if [ $# -eq 0 ]; then
    # Auto-start service if not running
    if ! systemctl is-active --quiet ollama; then
        print_header
        echo -e "${YELLOW}Starting ollama service...${NC}"
        sudo systemctl start ollama
        echo -e "${GREEN}✓${NC} Service started"
        sleep 2  # Wait for service to be ready
    fi

    # Check if a model is already loaded
    loaded=$(ollama ps 2>/dev/null | tail -n +2)

    if [ -n "$loaded" ]; then
        # Model already loaded, get the model name and run chat
        model=$(echo "$loaded" | head -n 1 | awk '{print $1}')
        save_selected_model "$model"
        echo -e "${GREEN}Using loaded model: ${model}${NC}"
        echo -e "${YELLOW}Running chat... (Ctrl+D to exit)${NC}\n"
        ollama run "$model"
    else
        # No model loaded, show selection
        print_header
        echo -e "${GREEN}●${NC} Ollama Service: ${GREEN}RUNNING${NC}"
        show_loaded_models
        select_model
    fi
else
    case $1 in
        list)
            if [ "${2:-}" = "--plain" ]; then
                list_models_plain
            else
                list_models
            fi
            ;;
        current)
            current_model
            ;;
        selected)
            load_selected_model
            ;;
        select)
            if [ -z "${2:-}" ]; then
                echo "Usage: monolith select <model>"
                exit 1
            fi
            save_selected_model "$2"
            echo -e "${GREEN}✓${NC} Selected model: $2"
            ;;
        start)
            sudo systemctl start ollama
            echo -e "${GREEN}✓${NC} Ollama started"
            ;;
        stop)
            sudo systemctl stop ollama
            echo -e "${GREEN}✓${NC} Ollama stopped"
            ;;
        status)
            check_ollama_status
            show_loaded_models
            ;;
        menu)
            show_menu
            ;;
        *)
            echo "Usage: monolith [list [--plain]|current|selected|select <model>|start|stop|status|menu]"
            echo "Or run without arguments to select and load a model"
            ;;
    esac
fi
