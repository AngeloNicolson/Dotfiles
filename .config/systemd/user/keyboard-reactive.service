[Unit]
Description=Reactive keyboard lighting (press fade + Super keybind hints) for the Omen Max 16
# omen-rgb must be installed (uv tool) and the 70-omen-rgb udev rule in place.
ConditionPathExists=%h/.local/share/uv/tools/omen-rgb/bin/python
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/share/uv/tools/omen-rgb/bin/python %h/.config/themes/keyboard-reactive.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
