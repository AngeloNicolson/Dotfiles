# You can put extra environment variables here
# https://wiki.hyprland.org/Configuring/Environment-variables/
#
# This file is machine-specific (gitignored). Copy to env.conf and edit.
# GPU backend vars belong here, NOT in the tracked hyprland.conf.

# ── NVIDIA ───────────────────────────────────────────────────────────────────
# env = GBM_BACKEND,nvidia-drm
# env = __GLX_VENDOR_LIBRARY_NAME,nvidia
# env = LIBVA_DRIVER_NAME,nvidia
# env = NVD_BACKEND,direct
# env = WLR_NO_HARDWARE_CURSORS,1
# Hybrid (Intel iGPU primary + NVIDIA dGPU): pick render order explicitly
# env = AQ_DRM_DEVICES,/dev/dri/card1:/dev/dri/card0

# ── Intel / AMD ──────────────────────────────────────────────────────────────
# Usually nothing needed — Hyprland auto-detects. For AMD video accel:
# env = LIBVA_DRIVER_NAME,radeonsi

# ── Backlight ────────────────────────────────────────────────────────────────
# Force which device init-backlight.sh controls (run `brightnessctl -l` to list).
# Useful on hybrid laptops exposing both nvidia_0 and intel_backlight.
# env = BACKLIGHT_DEVICE,intel_backlight
