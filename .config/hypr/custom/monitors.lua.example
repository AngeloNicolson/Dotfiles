-- Machine-specific monitor layout (gitignored). Required by hyprland.lua before
-- custom/general.lua, so anything in general.lua still wins.
--
-- Don't write this by hand — generate it from the monitors that are actually
-- connected (resolution, DPI-based scale, left-to-right layout):
--
--   ~/.config/hypr/scripts/gen-host-config.sh            # first time
--   ~/.config/hypr/scripts/gen-host-config.sh --force    # regenerate
--   ~/.config/hypr/scripts/gen-host-config.sh --dry-run  # preview only
--
-- Until then the universal fallback in hyprland.lua applies:
--   hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })
--
-- Format reminder:
-- hl.monitor({ output = "eDP-1",    mode = "highrr",    position = "0x0",    scale = 1.25 })
-- hl.monitor({ output = "HDMI-A-1", mode = "preferred", position = "2048x0", scale = 1 })
