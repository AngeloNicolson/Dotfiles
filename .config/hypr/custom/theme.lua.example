-- Generated by the AGS theme switcher (ags/theme.ts) whenever you pick a theme
-- (CORE page, SUPER+W carousel, or `ags request theme <name>`). Don't edit by hand.
-- It holds the theme's gaps/borders/rounding, blur, shadow, dimming and — for
-- themes with a "look" section, like kit — the all-windows opacity rules.
-- Loaded by hyprland.lua after rules.lua, so it overrides theme.lua's defaults.
--
-- Shape of the generated file:
-- if _G.__theme_opacity then _G.__theme_opacity:set_enabled(false); _G.__theme_opacity = nil end
-- if _G.__theme_opacity_keep then _G.__theme_opacity_keep:set_enabled(false); _G.__theme_opacity_keep = nil end
-- if _G.__theme_opacity_fs then _G.__theme_opacity_fs:set_enabled(false); _G.__theme_opacity_fs = nil end
