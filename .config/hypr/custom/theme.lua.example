--   decoration = { rounding = 4,
--     dim_inactive = true, dim_strength = 0.15,
--     blur = { enabled = true, size = 6, passes = 3, vibrancy = 0.15 },
--     shadow = { enabled = false, range = 8, render_power = 3 } },
-- })
