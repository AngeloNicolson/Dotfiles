-- This file is machine-specific (gitignored). Copy to env.lua and edit.
-- GPU backend vars belong here, NOT in the tracked hyprland.lua.

-- ── NVIDIA ───────────────────────────────────────────────────────────────────
-- hl.env("GBM_BACKEND", "nvidia-drm")
-- hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
-- hl.env("LIBVA_DRIVER_NAME", "nvidia")
-- hl.env("NVD_BACKEND", "direct")
-- hl.env("WLR_NO_HARDWARE_CURSORS", "1")
-- Hybrid (Intel iGPU primary + NVIDIA dGPU): pick render order explicitly
-- hl.env("AQ_DRM_DEVICES", "/dev/dri/card1:/dev/dri/card0")

-- ── Intel / AMD ──────────────────────────────────────────────────────────────
-- Usually nothing needed — Hyprland auto-detects. For AMD video accel:
-- hl.env("LIBVA_DRIVER_NAME", "radeonsi")

-- ── Backlight ────────────────────────────────────────────────────────────────
-- Force which device init-backlight.sh controls (run `brightnessctl -l` to list).
-- Useful on hybrid laptops exposing both nvidia_0 and intel_backlight.
-- hl.env("BACKLIGHT_DEVICE", "intel_backlight")
