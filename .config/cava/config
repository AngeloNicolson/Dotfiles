[general]
framerate = 60
bars = 0            ; 0 = auto-fit to terminal width
bar_width = 2
bar_spacing = 1

[input]
method = pipewire
source = auto       ; visualizes whatever is playing (MPD, browser, anything)

[output]
method = ncurses
channels = stereo

[color]
gradient = 1
gradient_count = 4
gradient_color_1 = '#0f3057'
gradient_color_2 = '#00587a'
gradient_color_3 = '#008891'
gradient_color_4 = '#e7e7de'

[smoothing]
monstercat = 1
noise_reduction = 77
