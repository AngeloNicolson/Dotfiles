# Fish shell
.config/fish/fish_variables
.config/fish/system-local.fish

# Foot (per-machine overrides, see host.ini.example)
.config/foot/host.ini

# swappy (rewritten by the app; see config.example)
.config/swappy/config

# Neovim
.config/nvim/node_modules/
.config/nvim/.luarc.json
.config/nvim/virtual-environments/
.config/nvim/startup.log

# AGS wallpapers: served from the wallpapers-v1 GitHub release, not git
.config/ags/wallpapers/*
!.config/ags/wallpapers/README.md

# AGS cache and state
.config/ags/.states.json
.config/ags/assets/music-themes/**/*.mp3

# Hyprland logs
.config/hypr/*.log

# Machine-specific Hyprland configs (use .example templates)
.config/hypr/custom/*.conf

# Python cache
__pycache__/
**/__pycache__/
*.pyc

# Claude Code
.claude/
**/.claude/

# Study cleanup list (local-only)
to-be-deleted.txt

# Installer component choices (per machine)
install.conf

# General
*.swp
*.swo
*~
.DS_Store

# Stray nvim log
nvim.log
